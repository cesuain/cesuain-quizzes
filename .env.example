# Supabase project settings → API Keys. Use the publishable key (sb_publishable_…);
# it is safe in the browser because every table is protected by RLS.
# For the local stack, `npx supabase status` prints both values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Public URL of the app, used in auth email links. Defaults to the request host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only for end-to-end tests (tests/e2e). Never expose these to the app.
# E2E_BASE_URL=http://localhost:3000
