{
  "name": "interview-quizzes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:seed:generate": "tsx scripts/generate-seed.ts",
    "db:start": "supabase start",
    "db:reset": "npm run db:seed:generate && supabase db reset",
    "db:push": "npm run db:seed:generate && supabase db push --include-seed",
    "db:types": "supabase gen types typescript --local --schema public > lib/supabase/database.types.tmp && mv lib/supabase/database.types.tmp lib/supabase/database.types.ts",
    "db:types:linked": "supabase gen types typescript --linked --schema public > lib/supabase/database.types.tmp && mv lib/supabase/database.types.tmp lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@cesuain/tokens": "^1.0.0",
    "@cesuain/ui": "^1.0.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.59.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9",
    "vitest": "^5.0.5"
  }
}
